# Environment variables for the sphere gallery project.
#
# Copy this file to .env (gitignored) and fill in real values:
#   cp .env.example .env
# Then upload everything to GitHub repository secrets with:
#   ./scripts/upload-secrets.sh
#
# Note: the app itself reads none of these — they exist only to provision CI
# secrets. GitHub secrets are write-only (replace/delete, never read back).

# Anthropic API key for the Claude code-review workflow
# (.github/workflows/pr-review.yml). Required for PR review comments.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Reserved for the later dynamic-image phase and authenticated e2e ---
# Not read by any current code; uncomment and fill in when that phase starts.
#TEST_USER=
#TEST_PASSWORD=
#VITE_EEN_CLIENT_ID=
#VITE_PROXY_URL=
